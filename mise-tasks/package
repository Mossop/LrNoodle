#!/usr/bin/env bash
#MISE description="Packages the plugin"
#MISE depends=["stylua", "luacheck", "typecheck"]
set -e

staging=$(mktemp -d)
cp -R LrNoodle.lrdevplugin "$staging/LrNoodle.lrplugin"
sed -e 's/org\.pixelbin\.lrnoodle-dev/org.pixelbin.lrnoodle/' \
    -e 's/LrNoodle-Dev/LrNoodle/' \
    LrNoodle.lrdevplugin/Info.lua > "$staging/LrNoodle.lrplugin/Info.lua"
rm -f LrNoodle.zip
(cd "$staging" && zip -r9 "$MISE_CONFIG_ROOT/LrNoodle.zip" LrNoodle.lrplugin)
rm -rf "$staging"
