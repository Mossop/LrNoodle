#!/usr/bin/env bash
#MISE description="Runs the integration tests against a Noodle Gallery server in docker"
set -e

root="${MISE_CONFIG_ROOT:-$(pwd)}"
compose=(docker compose --file "$root/tests/integration/docker-compose.yml")

"${compose[@]}" up --detach --wait --wait-timeout 300
trap '"${compose[@]}" down --volumes' EXIT

(cd "$root" && busted --run=integration "$@")
